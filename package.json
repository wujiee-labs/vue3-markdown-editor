{
  "name": "@wujiee/vue3-markdown-editor",
  "version": "0.1.0",
  "description": "A lightweight, themeable Markdown editor for Vue 3 forms.",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "keywords": [
    "vue",
    "vue3",
    "markdown",
    "editor",
    "textarea",
    "form"
  ],
  "author": "WUJIEE",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://wujiee.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wujiee-labs/vue3-markdown-editor.git"
  },
  "bugs": {
    "url": "https://github.com/wujiee-labs/vue3-markdown-editor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/markdown-it": "^14.1.2",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^18.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "vue": "^3.5.21",
    "vue-tsc": "^3.0.7"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "packageManager": "pnpm@9.4.0"
}
